#!/bin/sh
# =============================================================
#  ███████╗███████╗ ██████╗ ███╗   ██╗██╗███████╗
#  ╚══███╔╝██╔════╝██╔═══██╗████╗  ██║██║██╔════╝
#    ███╔╝ ███████╗██║   ██║██╔██╗ ██║██║█████╗
#   ███╔╝  ╚════██║██║   ██║██║╚██╗██║██║██╔══╝
#  ███████╗███████║╚██████╔╝██║ ╚████║██║███████╗
#  ╚══════╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝╚══════╝
#
#  PowerMenu - the powermenu page
#  Repo: https://github.com/SaruM4N3/42_bspwm_dotfile
# =============================================================

# &#10; is a pango line-break entity — keeps each entry as one stdin line
# so rofi treats icon+label as a single item, not two separate entries.
entry() {
    printf '<span font="Material Design Icons Desktop 32">%s</span>&#10;<span font="JetBrains Mono Bold 11">%s</span>' "$1" "$2"
}

LOCK=$(entry    "󰍁" "Lock")
GNOME=$(entry   "󰗽" "Back to GNOME")
LOGOUT=$(entry  "󰍃" "Logout")

rofi_cmd() {
    rofi -dmenu \
        -markup-rows \
        -p "Goodbye ${USER}" \
        -mesg "Uptime: $(uptime -p | sed -e 's/up //g')" \
        -theme "$HOME"/.config/bspwm/config/rofi-themes/PowerMenu.rasi \
        ${POLY_ROFI_POS:+-theme-str "$POLY_ROFI_POS"}
}

chosen=$(printf '%s\n' "$LOCK" "$GNOME" "$LOGOUT" | rofi_cmd)

case "$chosen" in
    *"󰍁"*) Lock ;;
    *"󰗽"*) Quit ;;
    *"󰍃"*) Logout ;;
esac
