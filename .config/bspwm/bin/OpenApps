#!/bin/sh
# =============================================================
#  ███████╗███████╗ ██████╗ ███╗   ██╗██╗███████╗
#  ╚══███╔╝██╔════╝██╔═══██╗████╗  ██║██║██╔════╝
#    ███╔╝ ███████╗██║   ██║██╔██╗ ██║██║█████╗
#   ███╔╝  ╚════██║██║   ██║██║╚██╗██║██║██╔══╝
#  ███████╗███████║╚██████╔╝██║ ╚████║██║███████╗
#  ╚══════╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝╚══════╝
#
#  OpenApps - Where everything is defined as default
#  Repo: https://github.com/SaruM4N3/42_bspwm_dotfile
# =============================================================

WIDGET_DIR="$HOME/.config/bspwm/eww"

case "$1" in
	--menu)
		RofiLauncher --launcher
		;;
	--rice)
		RiceSelector
		;;
	--terminal)
		Term --terminal
		;;
	--floating)
		Term --floating
		;;
	--update)
		Term --update
		;;
	--checkupdates)
		Term --checkupdates
		;;
	--netmanager)
		NetManagerDM
		;;
	--bluetooth)
		rofi-bluetooth
		;;
	--clipboard)
		clipcat-menu
		;;
	--screenshot)
		ScreenShoTer
		;;
	--powermenu)
		PowerMenu
		;;
	--keyboard)
		KeyBoardL
		;;
	--yazi)
		Term --yazi
		;;
	--nvim)
		Term --nvim
		;;
	--music)
		Term --music
		;;
	--fetch)
		Term --fetch
		;;
	--btop)
		Term --btop
		;;
	--scratch)
		scratchPad
		;;
		# Apps
	--filemanager)
		thunar --new-window
		;;
	--browser)
		brave
		;;
	--micro)
		Term --micro
		;;
	--editor)
		code
		;;
	--telegram)
		telegram-desktop
		;;
	--whats)
		firefox -new-tab https://web.whatsapp.com/
		;;
	--soundcontrol)
		pavucontrol
		;;
	--KeyHelp)
		eval "$(xrandr --current | awk '/\*/{match($0,/([0-9]+)x([0-9]+)/,a); if(a[2]+0>mh){mw=a[1]+0; mh=a[2]+0}} END{
			if(mh>=2160)      {wp=0.82; hp=0.78}
			else if(mh>=1440) {wp=0.80; hp=0.72}
			else              {wp=0.76; hp=0.66}
			printf "cs_w=%d cs_h=%d\n", mw*wp, mh*hp
		}')"
		eww -c "$WIDGET_DIR" update cheatsheet_data="$(gen-cheatsheet-data)"
		eww -c "$WIDGET_DIR" open --toggle csheet --size "${cs_w}x${cs_h}"
		;;
	--usercard)
		if eww -c "$WIDGET_DIR" active-windows 2>/dev/null | grep -q "launchermenu"; then
			eww -c "$WIDGET_DIR" close launchermenu
		else
			eww -c "$WIDGET_DIR" open launchermenu
		fi
		;;
	--player)
		if [ -n "$POLY_X" ] && [ -n "$POLY_BAR_BOTTOM" ]; then
			# eww --anchor "top left" uses absolute pixel coords.
			# Subtract half the music player width (~200px) to centre on click.
			_eww_left=$(( POLY_X - 200 ))
			if eww -c "$WIDGET_DIR" active-windows 2>/dev/null | grep -qw "music"; then
				eww -c "$WIDGET_DIR" close music
			else
				eww -c "$WIDGET_DIR" open music \
					--pos "${_eww_left}x${POLY_BAR_BOTTOM}" \
					--anchor "top left"
			fi
		else
			eww -c "$WIDGET_DIR" open --toggle music
		fi
		;;
	*)
		echo "Invalid Option"
		;;
esac
