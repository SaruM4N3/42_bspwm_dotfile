#!/bin/bash
# Send a command to the host-side watcher (bspwm.sh) for execution
# outside the bwrap overlay with full Ubuntu environment.
# Usage: host-run /usr/bin/unityhub [args...]      (line is eval'd as-is on the host)
#        host-run -q google-chrome-stable "$@"     (each argument is shell-quoted first,
#                                                    safe for URLs with & ? spaces...)

_HOST_REQ="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bspwm_host_req"
if [ ! -p "$_HOST_REQ" ]; then
    echo "host-run: FIFO not available (bspwm.sh not running?)" >&2
    exit 1
fi
if [ "$1" = "-q" ]; then
    shift
    _cmd=$(printf '%q ' "$@")
else
    _cmd="$*"
fi
echo "$_cmd" > "$_HOST_REQ" || echo "host-run: write failed" >&2
