#!/bin/sh
# =============================================================
#  ███████╗███████╗ ██████╗ ███╗   ██╗██╗███████╗
#  ╚══███╔╝██╔════╝██╔═══██╗████╗  ██║██║██╔════╝
#    ███╔╝ ███████╗██║   ██║██╔██╗ ██║██║█████╗
#   ███╔╝  ╚════██║██║   ██║██║╚██╗██║██║██╔══╝
#  ███████╗███████║╚██████╔╝██║ ╚████║██║███████╗
#  ╚══════╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝╚══════╝
#
#  KeyBoardL - Choose current layout
#  Repo: https://github.com/SaruM4N3/42_bspwm_dotfile
# =============================================================

# Get the current layout
CURRENT=$(setxkbmap -query | awk '/layout/ {print $2}')

# Layouts. You can add yours.
LAYOUTS="US English|us"

# Show rofi menu
show_rofi_menu() {
    printf '%s\n' "$LAYOUTS" | cut -d'|' -f1 | rofi \
        -dmenu \
        -p "Keyboard Layout" \
        -mesg "Current layout --> $CURRENT" \
        -markup-rows \
        -theme "$HOME/.config/bspwm/config/rofi-themes/Keyboard.rasi" \
        ${POLY_ROFI_POS:+-theme-str "$POLY_ROFI_POS"}
}

# Select and apply the layout
selected=$(show_rofi_menu)
if [ -n "$selected" ]; then
    layout_code=$(printf '%s\n' "$LAYOUTS" | awk -F'|' -v sel="$selected" '$1 == sel {print $2}')
    if [ -n "$layout_code" ]; then
        set -f
        set -- $layout_code
        set +f
        setxkbmap "$@"
    fi
fi
