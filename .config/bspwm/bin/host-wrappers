#!/bin/bash
# =============================================================
#  host-wrappers — run Ubuntu (GNOME) GUI apps on the host from a terminal
#
#  Inside bspwm (junest) /usr is the Arch tree over Ubuntu's: an Ubuntu app
#  typed in a terminal (firefox, gnome-calculator, nautilus...) is found in
#  /usr/bin but crashes with junest's libraries / without its GSettings
#  schemas. The launcher avoids this with app-launch; this does the same for
#  the command line: one small script per Ubuntu GUI app in
#  ~/.cache/bspwm/gnome-wrappers (before /usr/bin in PATH, see bspwmrc and
#  .zshrc), which sends the command to the host through host-run.
#
#  Apps wrapped: the GUI apps a menu lists (app-visibility programs: no
#  NoDisplay helpers, no Terminal=true tools) whose program app-launch would
#  run on the host (not from an Arch package, not in $HOME). Rebuilt at every
#  bspwm start (bspwmrc).
#
#  Usage: host-wrappers           rebuild the wrappers
#         host-wrappers --list    print "name<TAB>desktop file" of the wrapped apps
# =============================================================

DIR="$HOME/.cache/bspwm/gnome-wrappers"
MARK="# generated by host-wrappers"
OWN="$HOME/.config/bspwm/bin"

# "name<TAB>file" for each Ubuntu GUI app: listed in a menu (app-visibility,
# same rules as the launcher), program not from an Arch package nor in $HOME.
# Same decision as app-launch --where, with a single pacman call.
list_apps() {
    local file prog name path real
    declare -A seen=() cand=() file_of=()
    while IFS=$'\t' read -r file prog; do
        name=${prog##*/}
        [ -n "$name" ] && [ -z "${seen[$name]}" ] || continue
        seen[$name]=1
        # Our own launchers (discord, code, google-chrome...) already handle it
        [ -e "$OWN/$name" ] && continue
        # Same exception as app-launch: the /tmp installs run inside junest
        case "$name" in unityhub*) continue ;; esac
        # Mostly used as terminal tools (emacs -nw, x11vnc ...): their output must stay here
        case "$name" in emacs|x11vnc) continue ;; esac
        if [[ "$prog" == /* ]]; then path=$prog; else path=$(command -v -- "$prog"); fi
        case "$path" in "$HOME"/*|/tmp/*) continue ;; esac
        if [ -n "$path" ] && [ -e "$path" ]; then
            real=$(readlink -f -- "$path")
        else
            real=""   # not visible in junest (snap, host-only path): host
        fi
        cand[$name]=$real
        file_of[$name]=$file
    done < <(app-visibility programs)
    # pacman -Qo prints "error: No package owns X" for the files no Arch package owns
    declare -A unowned=()
    local reals=() r
    for r in "${cand[@]}"; do [ -n "$r" ] && reals+=("$r"); done
    if [ ${#reals[@]} -gt 0 ]; then
        while IFS= read -r r; do unowned[$r]=1; done < <(
            PACMAN_LOCAL=1 pacman -Qqo -- "${reals[@]}" 2>&1 >/dev/null | sed -n 's/^error: No package owns //p')
    fi
    for name in "${!cand[@]}"; do
        r=${cand[$name]}
        [ -z "$r" ] || [ -n "${unowned[$r]}" ] || continue
        printf '%s\t%s\n' "$name" "${file_of[$name]}"
    done | sort
}

if [ "$1" = "--list" ]; then
    list_apps
    exit 0
fi

mkdir -p "$DIR"
# Build in a temp dir, then swap: PATH lookups never see a half-built dir
tmp=$(mktemp -d "$DIR.XXXXXX") || exit 1
# Hand-made wrappers (make-host-wrapper) are kept
for f in "$DIR"/*; do
    [ -f "$f" ] && ! grep -qF "$MARK" "$f" && cp -p "$f" "$tmp/"
done
n=0
while IFS=$'\t' read -r name file; do
    [ -e "$tmp/$name" ] && continue
    cat > "$tmp/$name" <<EOF
#!/bin/bash
$MARK from $file
# Runs on the host, in this directory. Outside bspwm: the real program.
if [ -p "\${XDG_RUNTIME_DIR:-/run/user/\$(id -u)}/bspwm_host_req" ]; then
    exec host-run "cd \$(printf '%q' "\$PWD") 2>/dev/null; \$(printf '%q ' $(printf '%q' "$name") "\$@")"
fi
PATH=\$(printf '%s' "\$PATH" | tr ':' '\n' | grep -vxF "$DIR" | paste -sd:)
exec $(printf '%q' "$name") "\$@"
EOF
    chmod +x "$tmp/$name"
    n=$((n + 1))
done < <(list_apps)
rm -rf "$DIR.old"
mv "$DIR" "$DIR.old" && mv "$tmp" "$DIR" && rm -rf "$DIR.old"
echo "host-wrappers: $n Ubuntu apps wrapped in $DIR"
