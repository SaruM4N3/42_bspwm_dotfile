"""
Polybar port of LogtimeWidget (https://github.com/SaruM4N3/LogtimeWidget).

Reads the month from attendance.42lyon.fr/me (same done/needed hours as the site),
shows a month progress bar and a countdown before the next badge.

Files are shared with the GNOME extension:
  ~/.local/share/LogtimeWidget/session.json   attendance cookie (written by logtime-login)
  ~/.local/share/LogtimeWidget/settings.json  settings (edited by logtime-settings)
  ~/.local/share/LogtimeWidget/webkit/        login window browser data (keeps the intra login)

Usage:
  logtime-polybar --daemon     polybar tail=true mode
  logtime-polybar --refresh    tell the running daemon to refresh now (or log in)
  logtime-polybar --login      open the login window
  logtime-polybar --logout     forget the session
  logtime-polybar              print once and exit
"""

import json, math, os, shutil, signal, subprocess, sys, time, urllib.error, urllib.request
from datetime import datetime, timedelta, timezone
from zoneinfo import ZoneInfo

DATA_DIR      = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "LogtimeWidget")
SETTINGS_FILE = os.path.join(DATA_DIR, "settings.json")
SESSION_FILE  = os.path.join(DATA_DIR, "session.json")
WEBKIT_DIR    = os.path.join(DATA_DIR, "webkit")
BLINK_TEST    = os.path.join(DATA_DIR, "blink_test")
LOGIN_BIN     = os.path.join(os.path.dirname(os.path.realpath(__file__)), "logtime-login")

DATA_URL = "https://attendance.42lyon.fr/me/__data.json"
REFRESH_SECONDS = 60
BLINK_TEST_SECONDS = 5

TZ = ZoneInfo("Europe/Paris")
HOUR_MS = 3600 * 1000
WORKDAY_MS = 7 * HOUR_MS
CLOSURE_WINDOW_START = 8
CLOSURE_WINDOW_END = 20

DEFAULTS = {
    "showMinutes":         True,
    "displayFormat":       "all",       # ratio | remaining | all
    "startColor":          "#fff000",
    "endColor":            "#47ff00",
    "aheadColor":          "#00c8ff",
    "showCurrentDay":      False,
    "birthDate":           "",
    "showMoney":           True,
    "colorGradient":       "ease-out",
    "displayMode":         "bar",       # text | bar | combined
    "barColor":            "#47ff00",
    "badgeColor":          "#facc15",
    "badgeAlertColor":     "#ef4444",
    "badgeWarningMinutes": 15,
    "fontSize":            "small",     # polybar only: small | medium | large
}

# polybar font tag per size (1-indexed: font-0=T1, font-2=T3, font-3=T4)
FONT_TAG = {"small": 1, "medium": 3, "large": 4}
BAR_CELLS = 10
BAR_CHAR = "━"
BAR_EMPTY_COLOR = "#4b5263"
MUTED = "#9ca3af"

SESSION_EXPIRED = "expired"


# ── Files ─────────────────────────────────────────────────────

def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def load_settings():
    data = load_json(SETTINGS_FILE) or {}
    # Older GNOME versions: 'bar' display format, then a showBar toggle
    if data.get("displayFormat") == "bar":
        data["displayFormat"] = "ratio"
        data["showBar"] = True
    if not data.get("displayMode") and data.get("showBar") is not None:
        data["displayMode"] = "combined" if data["showBar"] else "text"
    cfg = dict(DEFAULTS)
    for k in DEFAULTS:
        if data.get(k) not in (None, ""):
            cfg[k] = data[k]
    return cfg


def load_cookie():
    return (load_json(SESSION_FILE) or {}).get("cookie", "")


def mtime(path):
    try:
        return os.stat(path).st_mtime
    except OSError:
        return None


def clear_session():
    try:
        os.remove(SESSION_FILE)
    except FileNotFoundError:
        pass
    shutil.rmtree(WEBKIT_DIR, ignore_errors=True)


def start_login():
    """Opens the login window; returns the process (it writes SESSION_FILE on success)."""
    os.makedirs(DATA_DIR, mode=0o700, exist_ok=True)
    return subprocess.Popen([LOGIN_BIN, SESSION_FILE, WEBKIT_DIR],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── attendance.42lyon.fr data ─────────────────────────────────

def to_ms(value):
    """Dates become epoch ms (like JS Date.getTime())."""
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return value
    return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp() * 1000


def unflatten(values):
    """Decodes the 'devalue' format SvelteKit uses for __data.json nodes."""
    specials = {-1: None, -3: math.nan, -4: math.inf, -5: -math.inf, -6: 0.0}
    hydrated = {}

    def hydrate(index):
        if index < 0:
            return specials.get(index)
        if index in hydrated:
            return hydrated[index]
        value = values[index]
        if isinstance(value, list):
            if value and isinstance(value[0], str):
                kind = value[0]
                if kind == "Date":
                    result = to_ms(value[1])
                elif kind in ("Set",):
                    result = [hydrate(v) for v in value[1:]]
                elif kind in ("Map", "null"):
                    result = {}
                    hydrated[index] = result
                    for i in range(1, len(value), 2):
                        result[hydrate(value[i])] = hydrate(value[i + 1])
                elif kind == "BigInt":
                    result = int(value[1])
                elif kind == "RegExp":
                    result = value[1]
                else:
                    result = hydrate(value[1])
                hydrated[index] = result
                return result
            result = []
            hydrated[index] = result
            for n in value:
                result.append(None if n == -2 else hydrate(n))
            return result
        if isinstance(value, dict):
            result = {}
            hydrated[index] = result
            for k, v in value.items():
                result[k] = hydrate(v)
            return result
        hydrated[index] = value
        return value

    return hydrate(0)


def extract_attendance(page):
    """The /me month node: {user, history, calendar, calendarUser, internships}."""
    for node in page.get("nodes") or []:
        if not node or node.get("type") != "data" or not isinstance(node.get("data"), list):
            continue
        data = unflatten(node["data"])
        if isinstance(data, dict) and data.get("calendar") and data.get("history") and data.get("user"):
            return data
    return None


def fetch_attendance(cookie):
    """Returns the attendance dict, SESSION_EXPIRED, or None on network/parse errors."""
    req = urllib.request.Request(DATA_URL, headers={"Cookie": cookie, "User-Agent": "Mozilla/5.0"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            body = resp.read().decode()
    except urllib.error.HTTPError as e:
        return SESSION_EXPIRED if e.code in (401, 403) else None
    except Exception:
        return None
    try:
        # SvelteKit may stream extra chunks on following lines; the page data is on the first one
        page = json.loads(body.split("\n")[0])
    except Exception:
        return None
    if page.get("type") == "redirect":
        return SESSION_EXPIRED
    return extract_attendance(page)


# ── Stats (ported from attendance.42lyon.fr AttendanceCompiler.compileStats) ──

def paris_key(ms):
    d = datetime.fromtimestamp(ms / 1000, TZ)
    return d.year * 10000 + d.month * 100 + d.day


def utc_key(value):
    d = datetime.fromtimestamp(to_ms(value) / 1000, timezone.utc)
    return d.year * 10000 + d.month * 100 + d.day


def paris_time(year, month, day, hour=0):
    return datetime(year, month, day, hour, tzinfo=TZ).timestamp() * 1000


def next_day_ms(year, month, day):
    return (datetime(year, month, day, tzinfo=TZ).date() + timedelta(days=1))


def clip(start, end, lo, hi):
    if start is None or end is None:
        return None
    s, e = max(start, lo), min(end, hi)
    return (s, e) if e > s else None


def subtract(rng, taken):
    """Parts of rng not already covered by taken."""
    start, end = rng
    pieces, cursor = [], start
    for ts, te in sorted(taken):
        s, e = max(ts, start), min(te, end)
        if e <= s:
            continue
        if s > cursor:
            pieces.append((cursor, s))
        cursor = max(cursor, e)
        if cursor >= end:
            break
    if cursor < end:
        pieces.append((cursor, end))
    return pieces


def day_attendance_ms(day_start, day_end, history, max_ping, with_locations, now):
    """Presences, plus locations on 'with locations' days. Closures win, overlaps count once."""
    groups = [(False, []), (True, []), (with_locations, [])]  # closures, presences, locations

    for c in history.get("closures") or []:
        r = clip(to_ms(c.get("beginAt")), to_ms(c.get("endAt")), day_start, day_end)
        if r:
            groups[0][1].append((r, True))

    for p in history.get("presences") or []:
        started, saved, ended = to_ms(p.get("beginAt")), to_ms(p.get("savedAt")), to_ms(p.get("endAt"))
        end = ended if ended is not None else saved
        r = clip(started, end, day_start, day_end)
        if r:
            groups[1][1].append((r, True))
        # An open presence only counts up to its last ping; the next maxPingInterval is "unsaved"
        if ended is None and saved is not None:
            unsaved_end = saved + max_ping
            if end < day_end and unsaved_end > day_start:
                groups[1][1].append(((end, unsaved_end), False))

    for loc in history.get("locations") or []:
        ended = to_ms(loc.get("endAt")) if loc.get("endAt") else now
        r = clip(to_ms(loc.get("beginAt")), ended, day_start, day_end)
        if r:
            groups[2][1].append((r, True))

    taken, total = [], 0
    for counted, ranges in groups:
        for rng, range_counted in ranges:
            for piece in subtract(rng, taken):
                taken.append(piece)
                if counted and range_counted:
                    total += piece[1] - piece[0]
    return total


def build_days(page, now):
    calendar, history, user = page["calendar"], page["history"], page["user"]
    year, month = calendar["year"], calendar["monthIndex"] + 1
    days_in_month = ((datetime(year + month // 12, month % 12 + 1, 1) - timedelta(days=1)).day)

    workdays = {paris_key(to_ms(d)) for d in calendar.get("workdays") or []}
    location_days = {paris_key(to_ms(d)) for d in calendar.get("withLocationsDays") or []}
    internships = [(paris_key(to_ms(i["start_at"])), paris_key(to_ms(i["end_at"])))
                   for i in page.get("internships") or []]
    absences = [(utc_key(a["beginDate"]), utc_key(a["endDate"])) for a in history.get("absences") or []]
    in_ranges = lambda key, ranges: any(lo <= key <= hi for lo, hi in ranges)
    max_ping = user.get("maxPingInterval") or 0

    days = []
    for day in range(1, days_in_month + 1):
        key = year * 10000 + month * 100 + day
        day_start = paris_time(year, month, day)
        nd = next_day_ms(year, month, day)
        day_end = paris_time(nd.year, nd.month, nd.day) - 1
        is_workday = key in workdays

        closure_ms = 0
        w_start = paris_time(year, month, day, CLOSURE_WINDOW_START)
        w_end = paris_time(year, month, day, CLOSURE_WINDOW_END)
        for c in history.get("closures") or []:
            r = clip(to_ms(c.get("beginAt")), to_ms(c.get("endAt")), w_start, w_end)
            if r:
                closure_ms += r[1] - r[0]

        days.append({
            "key": key,
            "isWorkday": is_workday,
            "excused": in_ranges(key, internships) or in_ranges(key, absences),
            "isClosureDay": is_workday and closure_ms >= WORKDAY_MS,
            "attendanceMs": day_attendance_ms(day_start, day_end, history, max_ping, key in location_days, now),
        })
    return days


def compile_stats(page, days, remuneration):
    def is_remunerated(key):
        return remuneration is None or utc_key(remuneration["beginDate"]) <= key <= utc_key(remuneration["endDate"])

    base = remunerated_days = closure_days = user_days = excused_days = 0
    raw_done = 0
    for d in days:
        # Time done on excused days (internship, absence) doesn't count
        if not d["excused"]:
            raw_done += d["attendanceMs"]
        if not d["isWorkday"]:
            continue
        rem = is_remunerated(d["key"])
        base += 1
        if rem:
            remunerated_days += 1
        if d["isClosureDay"]:
            closure_days += 1
        elif not d["excused"] and rem:
            user_days += 1
        if rem and (d["excused"] or d["isClosureDay"]):
            excused_days += 1

    after_excused = max(0, remunerated_days * WORKDAY_MS - excused_days * WORKDAY_MS)
    reduction_days = max(0, min(page["calendar"].get("workdayReduction") or 0, base))
    open_days = base - closure_days
    reduction_raw = reduction_days * WORKDAY_MS * (0 if open_days == 0 else user_days / open_days)
    reduction = reduction_raw - reduction_raw % HOUR_MS
    after_reduction = max(0, after_excused - reduction)
    capsules = sum(c["batch"]["valueMs"] for c in ((page.get("calendarUser") or {}).get("capsules") or []))
    todo = max(0, after_reduction - capsules)
    done = max(0, min(raw_done, todo))
    return {
        "doneMs": done,
        "rawDoneMs": raw_done,
        "todoMs": todo,
        "percent": 100 if todo == 0 else math.floor(done / todo * 100),
    }


def calculate_stats(page, now):
    """Like the site: one result per remuneration active this month, keeping the one with the most to do."""
    days = build_days(page, now)
    year, month = page["calendar"]["year"], page["calendar"]["monthIndex"] + 1
    month_start = paris_time(year, month, 1)
    month_end = paris_time(year + month // 12, month % 12 + 1, 1)
    active = [r for r in page["user"].get("remunerationUsers") or []
              if to_ms(r["beginDate"]) < month_end and to_ms(r["endDate"]) >= month_start]
    if not active:
        stats = compile_stats(page, days, None)
    else:
        stats = max((compile_stats(page, days, r) for r in active), key=lambda s: s["todoMs"])
    today = next((d for d in days if d["key"] == paris_key(now)), None)
    stats["todayMs"] = today["attendanceMs"] if today else 0
    return stats


def badge_status(page, now):
    """Time left before the ongoing presence expires (last ping's ttl runs from savedAt)."""
    max_ping = page["user"].get("maxPingInterval") or 0
    opened = [p for p in page["history"].get("presences") or [] if not p.get("endAt")]
    if not opened:
        return {"active": False, "remainingMs": 0, "ttlMs": max_ping}
    current = max(opened, key=lambda p: to_ms(p.get("beginAt")) or 0)
    saved = to_ms(current.get("savedAt")) or 0
    ping = next((p for p in current.get("pings") or [] if to_ms(p.get("timestamp")) == saved), None)
    ttl = (ping or {}).get("ttlMs") or max_ping
    remaining = max(0, saved + ttl - now)
    return {"active": remaining > 0, "remainingMs": remaining, "ttlMs": ttl}


# ── Formatting ────────────────────────────────────────────────

def monthly_rate(birth_date):
    """Barème Auvergne-Rhône-Alpes actualisé au 01/04/2025."""
    try:
        y, m, d = (int(x) for x in birth_date.split("-"))
        birth = datetime(y, m, d).date()
    except Exception:
        return None
    today = datetime.now().date()
    age = today.year - birth.year - ((today.month, today.day) < (birth.month, birth.day))
    if age >= 26: return 769.49
    if age >= 18: return 561.68
    if age >= 16: return 224.68
    return None


def format_duration(ms, show_minutes):
    total = int(ms // 60000)
    return f"{total // 60}h{total % 60:02d}" if show_minutes else f"{total // 60}h"


def format_ratio(stats, show_minutes):
    todo = stats["todoMs"]
    todo_text = f"{int(todo // HOUR_MS)}h" if todo % HOUR_MS == 0 else format_duration(todo, True)
    return f"{format_duration(stats['doneMs'], show_minutes)}/{todo_text}"


def format_text(stats, cfg):
    show_min = cfg["showMinutes"]
    ratio = format_ratio(stats, show_min)
    remaining = stats["todoMs"] - stats["rawDoneMs"]
    remaining_text = (f"+{format_duration(-remaining, show_min)} above!" if remaining < 0
                      else f"Remaining: {format_duration(remaining, show_min)}")
    fmt = cfg["displayFormat"]
    text = remaining_text if fmt == "remaining" else f"{ratio} | {remaining_text}" if fmt == "all" else ratio
    if cfg["showCurrentDay"]:
        text += f" | Today: {format_duration(stats['todayMs'], show_min)}"
    if cfg["showMoney"]:
        rate = monthly_rate(cfg["birthDate"])
        if rate is not None:
            earned = rate if stats["todoMs"] <= 0 else min(stats["doneMs"] / stats["todoMs"], 1.0) * rate
            text += f" | {earned:.2f}€"
    return text


def apply_curve(t, curve):
    if curve == "linear":       return t
    if curve == "ease-out":     return 1 - (1 - t) ** 2
    if curve == "cosine":       return math.sin(t * math.pi / 2)
    if curve == "sine":         return (1 - math.cos(t * math.pi)) / 2
    if curve == "smoothstep":   return t * t * (3 - 2 * t)
    if curve == "ease-in-out":  return 4 * t ** 3 if t < 0.5 else 1 - (-2 * t + 2) ** 3 / 2
    if curve == "smootherstep": return t ** 3 * (t * (t * 6 - 15) + 10)
    if curve == "quadratic":    return t ** 2
    if curve == "cubic":        return t ** 3
    if curve == "circular":     return 1 - math.sqrt(1 - t * t)
    if curve == "bounce":
        if t < 1 / 2.75:   return 7.5625 * t * t
        if t < 2 / 2.75:   t -= 1.5 / 2.75;   return 7.5625 * t * t + 0.75
        if t < 2.5 / 2.75: t -= 2.25 / 2.75;  return 7.5625 * t * t + 0.9375
        t -= 2.625 / 2.75; return 7.5625 * t * t + 0.984375
    return 0 if t == 0 else 2 ** (10 * t - 10)  # exponential


def interpolate_color(pct, cfg):
    def parse(h):
        h = h.lstrip("#")
        return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    if pct >= 1.0:
        r, g, b = parse(cfg["aheadColor"])
    else:
        (sr, sg, sb), (er, eg, eb) = parse(cfg["startColor"]), parse(cfg["endColor"])
        t = apply_curve(max(0.0, min(1.0, pct)), cfg["colorGradient"])
        r, g, b = sr + (er - sr) * t, sg + (eg - sg) * t, sb + (eb - sb) * t
    return f"#{round(r):02x}{round(g):02x}{round(b):02x}"


def colored(text, color):
    return f"%{{F{color}}}{text}%{{F-}}"


def bar(ratio, color):
    fill = round(BAR_CELLS * max(0.0, min(1.0, ratio)))
    out = colored(BAR_CHAR * fill, color) if fill else ""
    return out + (colored(BAR_CHAR * (BAR_CELLS - fill), BAR_EMPTY_COLOR) if fill < BAR_CELLS else "")


def render(page, cfg, now, blink_on, blink_test_until):
    """Returns (polybar line, needs_blink). Layout like the GNOME panel:
    [month bar] [ratio] [text] [badge bar] [countdown]"""
    stats = calculate_stats(page, now)
    pct = max(0.0, min(1.0, stats["percent"] / 100))
    mode, fmt = cfg["displayMode"], cfg["displayFormat"]
    show_bars = mode != "text"
    show_month = show_bars and fmt != "remaining"
    test_ms = blink_test_until * 1000 - now
    # The blink test shows the badge bar even when the display format hides it
    show_badge = test_ms > 0 or (show_bars and fmt != "ratio")

    parts = []
    if show_month:
        parts.append(bar(pct, cfg["barColor"]))
        parts.append(colored(format_ratio(stats, cfg["showMinutes"]), cfg["barColor"]))
    if mode != "bar":
        parts.append(colored(format_text(stats, cfg), interpolate_color(pct, cfg)))

    blinking = False
    if show_badge:
        badge = badge_status(page, now)
        ratio = badge["remainingMs"] / badge["ttlMs"] if badge["ttlMs"] > 0 else 0
        warning = badge["active"] and badge["remainingMs"] <= cfg["badgeWarningMinutes"] * 60 * 1000
        if warning or test_ms > 0:
            remaining = badge["remainingMs"] if warning else test_ms
            if not warning and not badge["active"]:
                ratio = 1
            seconds = math.ceil(remaining / 1000)
            color = cfg["badgeAlertColor"] if blink_on else BAR_EMPTY_COLOR
            parts.append(bar(ratio, color))
            parts.append(colored(f"Badge! {seconds // 60}:{seconds % 60:02d}", color))
            blinking = True
        elif badge["active"]:
            parts.append(bar(ratio, cfg["badgeColor"]))
            parts.append(colored(format_duration(badge["remainingMs"], True), cfg["badgeColor"]))
        else:
            parts.append(bar(0, cfg["badgeColor"]))
            parts.append(colored("No session", MUTED))

    return wrap(" ".join(parts), cfg), blinking


def wrap(content, cfg):
    return f"%{{T{FONT_TAG.get(cfg['fontSize'], 1)}}} {content}%{{T-}}"


def status(text, color, cfg):
    return wrap(colored(text, color), cfg)


# ── Daemon ────────────────────────────────────────────────────

class Daemon:
    def __init__(self):
        self.page = None
        self.state = "connecting"   # connecting | ok | login | logged_out | offline
        self.cookie = ""
        self.login_proc = None
        self.last_fetch = 0.0
        self.force = False
        self.session_mtime = mtime(SESSION_FILE)
        self.blink_mtime = mtime(BLINK_TEST)
        self.blink_test_until = 0.0
        self.blink_on = True

    def request_refresh(self, *_):
        self.force = True

    def login(self):
        if self.login_proc and self.login_proc.poll() is None:
            return
        self.page = None
        self.state = "login"
        try:
            self.login_proc = start_login()
        except Exception:
            self.login_proc = None
            self.state = "logged_out"

    def refresh(self):
        self.last_fetch = time.time()
        self.cookie = load_cookie()
        if not self.cookie:
            self.login()
            return
        data = fetch_attendance(self.cookie)
        if data == SESSION_EXPIRED:
            self.login()
        elif data is None:
            if self.page is None:
                self.state = "offline"
        else:
            self.page, self.state = data, "ok"

    def tick(self):
        now = time.time()

        # Login window closed: reconnect on success, otherwise wait for a click
        if self.login_proc and self.login_proc.poll() is not None:
            ok = self.login_proc.returncode == 0
            self.login_proc = None
            self.session_mtime = mtime(SESSION_FILE)
            if ok:
                self.refresh()
            else:
                self.state = "logged_out"

        # Session saved by another login window (GNOME extension) or cleared from Settings
        m = mtime(SESSION_FILE)
        if m != self.session_mtime:
            self.session_mtime = m
            if self.login_proc is None:
                self.state = "connecting"
                self.page = None
                self.refresh()

        m = mtime(BLINK_TEST)
        if m != self.blink_mtime:
            self.blink_mtime = m
            self.blink_test_until = now + BLINK_TEST_SECONDS

        if self.force:
            self.force = False
            if self.state in ("logged_out", "login") and self.login_proc is None:
                self.login()
            elif self.login_proc is None:
                self.refresh()
        elif self.state not in ("login", "logged_out") and now - self.last_fetch >= REFRESH_SECONDS:
            self.refresh()

    def line(self, cfg):
        if self.state == "ok" and self.page:
            try:
                text, blinking = render(self.page, cfg, time.time() * 1000, self.blink_on, self.blink_test_until)
                return text, blinking
            except Exception:
                return status("Logtime: data error", "#ef4444", cfg), False
        if self.state == "login":
            return status("Log in to Attendance...", "#f59e0b", cfg), False
        if self.state == "logged_out":
            return status("Not logged in: right-click to reconnect", "#ef4444", cfg), False
        if self.state == "offline":
            return status("Logtime: offline", MUTED, cfg), False
        return status("Connecting...", "#10b981", cfg), False

    def run(self):
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        signal.signal(signal.SIGUSR1, self.request_refresh)
        self.refresh()
        last = None
        while True:
            self.tick()
            text, blinking = self.line(load_settings())
            if text != last:
                print(text, flush=True)
                last = text
            if blinking:
                self.blink_on = not self.blink_on
                time.sleep(0.5)
            else:
                self.blink_on = True
                time.sleep(1)


def signal_daemon():
    """SIGUSR1 to running daemons; only python processes running this script with --daemon."""
    me = os.getpid()
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                args = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except OSError:
            continue
        if (int(pid) != me and len(args) >= 3 and "python" in os.path.basename(args[0])
                and os.path.basename(args[1]) == "logtime-polybar" and "--daemon" in args[2:]):
            try:
                os.kill(int(pid), signal.SIGUSR1)
            except OSError:
                pass


def main():
    if "--daemon" in sys.argv:
        Daemon().run()
    elif "--refresh" in sys.argv:
        signal_daemon()
    elif "--login" in sys.argv:
        start_login()
    elif "--logout" in sys.argv:
        clear_session()
    else:
        cfg = load_settings()
        cookie = load_cookie()
        data = fetch_attendance(cookie) if cookie else SESSION_EXPIRED
        if data == SESSION_EXPIRED:
            print("Not logged in: run logtime-polybar --login")
        elif data is None:
            print("Logtime: offline")
        else:
            print(render(data, cfg, time.time() * 1000, True, 0)[0])


if __name__ == "__main__":
    main()
