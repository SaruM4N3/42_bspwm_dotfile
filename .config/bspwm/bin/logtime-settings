#!/usr/bin/env python3
"""
Logtime settings window — bspwm/polybar edition of LogtimeWidget
"""

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk
import json, os, shutil, subprocess, time

DATA_DIR      = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "LogtimeWidget")
SETTINGS_FILE = os.path.join(DATA_DIR, "settings.json")
SESSION_FILE  = os.path.join(DATA_DIR, "session.json")
WEBKIT_DIR    = os.path.join(DATA_DIR, "webkit")
BLINK_TEST    = os.path.join(DATA_DIR, "blink_test")
LOGIN_BIN     = os.path.join(os.path.dirname(os.path.realpath(__file__)), "logtime-login")

# Same defaults as logtime-polybar / the GNOME extension
DEFAULTS = {
    "showMinutes":         True,
    "displayFormat":       "all",
    "startColor":          "#fff000",
    "endColor":            "#47ff00",
    "aheadColor":          "#00c8ff",
    "showCurrentDay":      False,
    "birthDate":           "",
    "showMoney":           True,
    "colorGradient":       "ease-out",
    "displayMode":         "bar",
    "barColor":            "#47ff00",
    "badgeColor":          "#facc15",
    "badgeAlertColor":     "#ef4444",
    "badgeWarningMinutes": 15,
    "fontSize":            "small",
}

CSS = b"""
window { background-color: #2f354b; color: #FDFDFD; }
frame { border: 1px solid #8897F4; border-radius: 6px; }
frame > label { color: #8897F4; font-weight: bold; padding: 0 4px; }
entry {
    background-color: #1e2335; color: #FDFDFD;
    border: 1px solid #8897F4; border-radius: 4px; padding: 4px 8px;
}
entry:focus { border-color: #79E6F3; }
combobox button {
    background-color: #1e2335; color: #FDFDFD;
    border: 1px solid #8897F4; border-radius: 4px; padding: 3px 6px;
}
checkbutton label { color: #FDFDFD; }
checkbutton check { background-color: #1e2335; border: 1px solid #8897F4; border-radius: 3px; }
checkbutton:checked check { background-color: #8897F4; }
spinbutton { background-color: #1e2335; color: #FDFDFD; border: 1px solid #8897F4; border-radius: 4px; }
spinbutton button { background-color: #1e2335; color: #8897F4; border: none; }
label { color: #FDFDFD; }
colorbutton button { border: 1px solid #8897F4; border-radius: 4px; }
button.save {
    background-color: #5ADECD; color: #2f354b;
    border: none; border-radius: 4px; font-weight: bold; padding: 6px 16px;
}
button.save:hover { background-color: #79E6F3; }
button.cancel {
    background-color: #1e2335; color: #FDFDFD;
    border: 1px solid #8897F4; border-radius: 4px; padding: 6px 16px;
}
button.cancel:hover { background-color: #3a4060; }
button.danger {
    background-color: #1e2335; color: #ef4444;
    border: 1px solid #ef4444; border-radius: 4px; padding: 4px 12px;
}
button.danger:hover { background-color: #3a2030; }
separator { background-color: #8897F4; min-height: 1px; opacity: 0.3; }
"""


def load_json(path, default=None):
    try:
        with open(path) as f:
            return {**default, **json.load(f)} if default else json.load(f)
    except Exception:
        return dict(default) if default else {}


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, indent=2)


def make_label(text, width=145):
    lbl = Gtk.Label(label=text, xalign=0)
    lbl.set_size_request(width, -1)
    return lbl


def make_row(*widgets):
    row = Gtk.Box(spacing=10)
    for w in widgets:
        expand = isinstance(w, (Gtk.Entry, Gtk.ComboBoxText))
        row.pack_start(w, expand, expand, 0)
    return row


def hex_to_rgba(h):
    rgba = Gdk.RGBA()
    rgba.parse(h)
    return rgba


def rgba_to_hex(rgba):
    r, g, b = int(rgba.red * 255), int(rgba.green * 255), int(rgba.blue * 255)
    return f"#{r:02x}{g:02x}{b:02x}"


def make_color_btn(hex_color):
    btn = Gtk.ColorButton()
    btn.set_rgba(hex_to_rgba(hex_color))
    btn.set_use_alpha(False)
    btn.set_title("Pick color")
    return btn


def make_section(title):
    frame = Gtk.Frame(label=f"  {title}  ")
    box   = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    box.set_border_width(12)
    frame.add(box)
    return frame, box


def notify_daemon():
    """Ask the running logtime-polybar daemon to refresh (it also watches the files)."""
    polybar_script = os.path.join(os.path.dirname(os.path.realpath(__file__)), "logtime-polybar")
    subprocess.run([polybar_script, "--refresh"], capture_output=True)


class LogtimeSettings(Gtk.Window):
    def __init__(self):
        super().__init__(title="Logtime Settings")
        self.set_default_size(440, -1)
        self.set_border_width(16)
        self.set_resizable(False)

        poly_x   = os.environ.get("POLY_X")
        poly_y   = os.environ.get("POLY_BAR_BOTTOM")
        if poly_x and poly_y:
            # Appear below the clicked polybar module, centred on click X
            self.set_position(Gtk.WindowPosition.NONE)
            # move() after realize so the window manager honours it
            self.connect("realize", lambda _: self.move(
                int(poly_x) - 220,   # 220 = half of 440px default width
                int(poly_y)
            ))
        else:
            self.set_position(Gtk.WindowPosition.CENTER)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.settings = load_json(SETTINGS_FILE, DEFAULTS)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(root)

        # ── Account ───────────────────────────────────────────
        acc_frame, acc_box = make_section("Account  (attendance.42lyon.fr)")

        self.account_label = Gtk.Label(xalign=0)
        login_btn = Gtk.Button(label="Log in")
        login_btn.get_style_context().add_class("cancel")
        login_btn.connect("clicked", self.on_login)
        logout_btn = Gtk.Button(label="Log out / Switch account")
        logout_btn.get_style_context().add_class("danger")
        logout_btn.connect("clicked", self.on_logout)
        self.update_account_label()

        acc_row = Gtk.Box(spacing=8)
        acc_row.pack_start(self.account_label, True, True, 0)
        acc_row.pack_end(logout_btn, False, False, 0)
        acc_row.pack_end(login_btn, False, False, 0)
        acc_box.pack_start(acc_row, False, False, 0)

        # ── Display ───────────────────────────────────────────
        disp_frame, disp_box = make_section("Display")

        self.fmt_combo = Gtk.ComboBoxText()
        for k, v in [("ratio", "Current / Needed  —  50h47/84h"),
                     ("remaining", "Remaining  —  Remaining: 33h12"),
                     ("all", "Combined  —  50h47/84h | Remaining: 33h12")]:
            self.fmt_combo.append(k, v)
        self.fmt_combo.set_active_id(self.settings.get("displayFormat", "all"))

        self.mode_combo = Gtk.ComboBoxText()
        for k, v in [("text", "Text"),
                     ("bar", "Progress bar"),
                     ("combined", "Combined  (text + bars)")]:
            self.mode_combo.append(k, v)
        self.mode_combo.set_active_id(self.settings.get("displayMode", "bar"))

        self.size_combo = Gtk.ComboBoxText()
        for k, v in [("small", "Small"), ("medium", "Medium"), ("large", "Large")]:
            self.size_combo.append(k, v)
        self.size_combo.set_active_id(self.settings.get("fontSize", "small"))

        self.minutes_check = Gtk.CheckButton(label="Show minutes")
        self.minutes_check.set_active(self.settings.get("showMinutes", True))

        self.today_check = Gtk.CheckButton(label="Show today's hours")
        self.today_check.set_active(self.settings.get("showCurrentDay", False))

        disp_box.pack_start(make_row(make_label("Format"), self.fmt_combo), False, False, 0)
        disp_box.pack_start(make_row(make_label("Display mode"), self.mode_combo), False, False, 0)
        hint = Gtk.Label(xalign=0)
        hint.set_markup('<small>Bars: Current/Needed → month bar, Remaining → badge countdown, Combined → both</small>')
        hint.set_line_wrap(True)
        disp_box.pack_start(hint, False, False, 0)
        disp_box.pack_start(make_row(make_label("Font size"), self.size_combo), False, False, 0)
        disp_box.pack_start(self.minutes_check, False, False, 0)
        disp_box.pack_start(self.today_check,   False, False, 0)

        # ── Gratification ─────────────────────────────────────
        grat_frame, grat_box = make_section("Gratification  (Barème Auvergne-Rhône-Alpes)")

        self.birth_entry = Gtk.Entry()
        self.birth_entry.set_text(self.settings.get("birthDate", ""))
        self.birth_entry.set_placeholder_text("YYYY-MM-DD")

        self.money_check = Gtk.CheckButton(label="Show earned money")
        self.money_check.set_active(self.settings.get("showMoney", True))

        grat_box.pack_start(make_row(make_label("Birth date"), self.birth_entry), False, False, 0)
        grat_box.pack_start(self.money_check, False, False, 0)

        # ── Colors ────────────────────────────────────────────
        col_frame, col_box = make_section("Colors")

        self.start_btn = make_color_btn(self.settings["startColor"])
        self.end_btn   = make_color_btn(self.settings["endColor"])
        self.ahead_btn = make_color_btn(self.settings["aheadColor"])

        self.curve_combo = Gtk.ComboBoxText()
        for k, v in [
            ("linear",       "Linear"),
            ("ease-out",     "Ease out  (default)"),
            ("cosine",       "Cosine"),
            ("sine",         "Sine  (S-curve)"),
            ("smoothstep",   "Smoothstep  (S-curve)"),
            ("ease-in-out",  "Ease in-out  (S-curve)"),
            ("smootherstep", "Smootherstep  (S-curve)"),
            ("quadratic",    "Quadratic"),
            ("cubic",        "Cubic"),
            ("circular",     "Circular"),
            ("bounce",       "Bounce"),
            ("exponential",  "Exponential"),
        ]:
            self.curve_combo.append(k, v)
        self.curve_combo.set_active_id(self.settings["colorGradient"])

        col_box.pack_start(make_row(make_label("Below target  (0%)"),  self.start_btn), False, False, 0)
        col_box.pack_start(make_row(make_label("On target  (100%)"),   self.end_btn),   False, False, 0)
        col_box.pack_start(make_row(make_label("Above target"),        self.ahead_btn), False, False, 0)
        col_box.pack_start(make_row(make_label("Gradient curve"),      self.curve_combo), False, False, 0)

        # ── Bars & badge ──────────────────────────────────────
        bars_frame, bars_box = make_section("Bars & badge")

        self.bar_btn         = make_color_btn(self.settings["barColor"])
        self.badge_btn       = make_color_btn(self.settings["badgeColor"])
        self.badge_alert_btn = make_color_btn(self.settings["badgeAlertColor"])

        self.warning_spin = Gtk.SpinButton.new_with_range(1, 240, 1)
        self.warning_spin.set_value(int(self.settings["badgeWarningMinutes"]))

        test_btn = Gtk.Button(label="Test blink")
        test_btn.get_style_context().add_class("cancel")
        test_btn.connect("clicked", self.on_blink_test)

        bars_box.pack_start(make_row(make_label("Month bar"),          self.bar_btn),         False, False, 0)
        bars_box.pack_start(make_row(make_label("Badge bar"),          self.badge_btn),       False, False, 0)
        bars_box.pack_start(make_row(make_label("Badge alert"),        self.badge_alert_btn), False, False, 0)
        bars_box.pack_start(make_row(make_label("Blink before (min)"), self.warning_spin, test_btn), False, False, 0)

        # ── Buttons ───────────────────────────────────────────
        btn_box = Gtk.Box(spacing=8)
        btn_box.set_halign(Gtk.Align.END)

        cancel_btn = Gtk.Button(label="Cancel")
        cancel_btn.get_style_context().add_class("cancel")
        cancel_btn.connect("clicked", lambda _: self.destroy())

        save_btn = Gtk.Button(label="Save")
        save_btn.get_style_context().add_class("save")
        save_btn.connect("clicked", self.on_save)

        btn_box.pack_start(cancel_btn, False, False, 0)
        btn_box.pack_start(save_btn,   False, False, 0)

        for w in (acc_frame, disp_frame, grat_frame, col_frame, bars_frame, btn_box):
            root.pack_start(w, False, False, 0)

        self.connect("destroy", Gtk.main_quit)
        self.show_all()

    def update_account_label(self):
        logged_in = bool(load_json(SESSION_FILE, {"cookie": ""}).get("cookie"))
        self.account_label.set_text("Logged in" if logged_in else "Not logged in")

    def on_login(self, _):
        os.makedirs(DATA_DIR, mode=0o700, exist_ok=True)
        subprocess.Popen([LOGIN_BIN, SESSION_FILE, WEBKIT_DIR],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.destroy()

    def on_logout(self, _):
        # The daemon sees the session disappear and opens the login window
        try:
            os.remove(SESSION_FILE)
        except FileNotFoundError:
            pass
        shutil.rmtree(WEBKIT_DIR, ignore_errors=True)
        self.update_account_label()

    def on_blink_test(self, _):
        os.makedirs(DATA_DIR, mode=0o700, exist_ok=True)
        with open(BLINK_TEST, "w") as f:
            f.write(str(int(time.time() * 1000)))

    def on_save(self, _):
        # Keep keys this window doesn't edit (e.g. the GNOME extension's panelPosition)
        data = load_json(SETTINGS_FILE, {})
        data.update({
            "displayFormat":       self.fmt_combo.get_active_id(),
            "displayMode":         self.mode_combo.get_active_id(),
            "fontSize":            self.size_combo.get_active_id(),
            "showMinutes":         self.minutes_check.get_active(),
            "showCurrentDay":      self.today_check.get_active(),
            "showMoney":           self.money_check.get_active(),
            "birthDate":           self.birth_entry.get_text().strip(),
            "startColor":          rgba_to_hex(self.start_btn.get_rgba()),
            "endColor":            rgba_to_hex(self.end_btn.get_rgba()),
            "aheadColor":          rgba_to_hex(self.ahead_btn.get_rgba()),
            "colorGradient":       self.curve_combo.get_active_id(),
            "barColor":            rgba_to_hex(self.bar_btn.get_rgba()),
            "badgeColor":          rgba_to_hex(self.badge_btn.get_rgba()),
            "badgeAlertColor":     rgba_to_hex(self.badge_alert_btn.get_rgba()),
            "badgeWarningMinutes": int(self.warning_spin.get_value()),
        })
        save_json(SETTINGS_FILE, data)
        notify_daemon()
        self.destroy()


if __name__ == "__main__":
    # Toggle: if a settings window is already open, close it and exit
    # (only python processes running this script, not editors/shells mentioning it)
    open_pids = []
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                args = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except OSError:
            continue
        if (int(pid) != os.getpid() and len(args) >= 2 and "python" in os.path.basename(args[0])
                and os.path.basename(args[1]) == "logtime-settings"):
            open_pids.append(int(pid))
    if open_pids:
        for pid in open_pids:
            try:
                os.kill(pid, 15)
            except OSError:
                pass
        raise SystemExit(0)

    LogtimeSettings()
    Gtk.main()
