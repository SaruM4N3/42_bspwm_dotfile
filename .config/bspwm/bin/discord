#!/bin/sh
# =============================================================
#  discord — launcher for bspwm/junest environment
#
#  Discord is the Ubuntu .deb (/usr/bin/discord on the host, the same
#  one GNOME launches). Inside junest, /usr/bin/discord is hidden by an
#  overlay whiteout left by an old Arch package, and the Ubuntu Electron
#  build expects Ubuntu libs anyway, so run it on the host via host-run.
# =============================================================

if command -v host-run >/dev/null 2>&1 && [ -p "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bspwm_host_req" ]; then
    exec host-run discord "$@"
fi
exec "$HOME/.config/discord/Discord" "$@"
