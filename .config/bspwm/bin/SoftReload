#!/bin/sh
# =============================================================
#  ███████╗███████╗ ██████╗ ███╗   ██╗██╗███████╗
#  ╚══███╔╝██╔════╝██╔═══██╗████╗  ██║██║██╔════╝
#    ███╔╝ ███████╗██║   ██║██╔██╗ ██║██║█████╗
#   ███╔╝  ╚════██║██║   ██║██║╚██╗██║██║██╔══╝
#  ███████╗███████║╚██████╔╝██║ ╚████║██║███████╗
#  ╚══════╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝╚══════╝
#
# SoftReload - SoftReload bspwm by reloading stuff like eww picom etc
#  Repo: https://github.com/SaruM4N3/42_bspwm_dotfile
# =============================================================

CONFIG_DIR="$HOME/.config/bspwm"
RICES_DIR="$CONFIG_DIR/rices"
DUNST_CONFIG="$CONFIG_DIR/config/dunstrc"
read -r CURRENT_RICE < "$CONFIG_DIR"/.rice

save-config

reload() {
    # Restart picom FIRST so it is ready before polybar creates its ARGB window.
    # Full restart instead of USR1: SIGUSR1 hot-reload resets picom's texture cache
    # and damage state mid-session, causing border color and resize glitch regressions.
    pkill -x picom 2>/dev/null || true
    sleep 0.1
    GL_SHIM="${HOME}/.config/bspwm/gl-host"
    LD_LIBRARY_PATH="${GL_SHIM}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    LIBGL_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri \
    picom --config "${HOME}/.config/bspwm/config/picom.conf" &
    sleep 0.15

    # Reload bars polybar or eww
    if pgrep -x polybar >/dev/null; then
        polybar-msg cmd restart >/dev/null
    else
        eww_bar_config="$RICES_DIR/$CURRENT_RICE/bar"
        [ -d "$eww_bar_config" ] && eww reload -c "$eww_bar_config"
    fi

    # Reload remaining services
    pkill -1 xsettingsd 2>/dev/null || true
    pkill -USR1 -x sxhkd 2>/dev/null || true
    dunstctl reload "$DUNST_CONFIG" 2>/dev/null || true

    # Reload EWW widgets
    main_eww="$CONFIG_DIR/eww"
    if eww ping -c "$main_eww" >/dev/null; then
        eww reload -c "$main_eww"
    fi
}

# Send notification
if reload; then
    dunstify -i dialog-information "Environment Reloaded!" \
    "Reloaded Settings:\n• ${CURRENT_RICE} Bar\n• Picom\n• Xsettingsd\n• SXHKD\n• Dunst\n• EWW Widgets"
fi
