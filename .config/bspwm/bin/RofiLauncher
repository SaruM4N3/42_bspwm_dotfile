#!/bin/sh
# =============================================================
#  ███████╗███████╗ ██████╗ ███╗   ██╗██╗███████╗
#  ╚══███╔╝██╔════╝██╔═══██╗████╗  ██║██║██╔════╝
#    ███╔╝ ███████╗██║   ██║██╔██╗ ██║██║█████╗
#   ███╔╝  ╚════██║██║   ██║██║╚██╗██║██║██╔══╝
#  ███████╗███████║╚██████╔╝██║ ╚████║██║███████╗
#  ╚══════╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝╚══════╝
#
#  RofiLauncher — launch the rofilauncher that search for .desktop
#  Repo: https://github.com/SaruM4N3/42_bspwm_dotfile
# =============================================================

# Main vars
cfgStyle="$HOME/.config/bspwm/config/.launcher"
[ -f "$cfgStyle" ] || echo "1" > "$cfgStyle"
read -r current_style < "$cfgStyle"

# Paths
styleDir="$HOME/.config/bspwm/config/rofi-themes"
rofiAssetDir="$HOME/.config/bspwm/config/assets"

# Function to select the styles
choose_launcher_style() {

    # Find styles
    styles=$(find "$styleDir" -type f -name 'style_*.rasi' | sed 's|.*/style_\([0-9]*\)\.rasi|\1|' | sort -n)

    # Find current style
    selected_index=-1
    index=0
    IFS='
'
    for style in $styles; do
        if [ "$style" = "$current_style" ]; then
            selected_index=$index
            break
        fi
        index=$((index + 1))
    done
    unset IFS

    # Show the rofi selection menu
    selected=$(
    IFS='
'
    for style in $styles; do
        printf "%s\000icon\037%s/style_%s.webp\n" "$style" "$rofiAssetDir" "$style"
    done | rofi -dmenu \
                -theme "$styleDir/StyleSelect.rasi" \
                -selected-row "$selected_index"
    )

    # Write the selection to config file
    [ -n "$selected" ] && echo "${selected}" > "$cfgStyle"

}

launch_launcher () {
    ROFI_THEME="$styleDir/style_$current_style.rasi"

    # rofi 2.x drun starts the chosen app itself through GIO, inside junest, and
    # ignores -run-command: Ubuntu (GNOME) apps then crash there. So rofi only
    # picks (-dmenu, list from app-visibility: shown apps, icons, most used
    # first) and app-launch starts the app, on the host for Ubuntu apps.
    # ctrl+x = custom-1 (exit 10) → hide the app (see app-visibility).
    paths=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/launcher.XXXXXX") || return
    index=$(app-visibility menu "$paths" | rofi -dmenu -i -no-custom \
        -theme "$ROFI_THEME" \
        -kb-cancel "Escape,Super+space" \
        -kb-custom-1 "ctrl+x" \
        -format 'i' \
        ${POLY_ROFI_POS:+-theme-str "$POLY_ROFI_POS"})
    rc=$?
    case "$index" in ''|*[!0-9]*) rm -f "$paths"; return ;; esac
    result=$(sed -n "$((index + 1))p" "$paths")
    rm -f "$paths"
    [ -n "$result" ] || return

    case $rc in
        0)
            app-launch "$result" >/dev/null 2>&1 &
            app-visibility launched "$result" 2>/dev/null
            ;;
        10)
            # ctrl+x — hide the app from the bspwm launcher only (GNOME keeps it).
            # Shown again from Rice Settings > Apps.
            app_name=$(grep -m1 "^Name=" "$result" 2>/dev/null | cut -d= -f2)
            [ -z "$app_name" ] && app_name=$(basename "$result" .desktop)
            confirm=$(printf "Yes\nNo" | rofi -dmenu \
                -theme "$ROFI_THEME" \
                -p "Hide '$app_name' from launcher?")
            if [ "$confirm" = "Yes" ] && app-visibility hide "$result"; then
                dunstify -u low "Hidden" "'$app_name' hidden from the launcher (Rice Settings > Apps to show it again)."
            fi
            ;;
    esac
}

# -- Main executor -- #
case "$1" in
    --choose-style)
        choose_launcher_style ;;
    --launcher | *)
        launch_launcher ;;
esac
