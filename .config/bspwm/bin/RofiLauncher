#!/bin/sh
# =============================================================
#  ███████╗███████╗ ██████╗ ███╗   ██╗██╗███████╗
#  ╚══███╔╝██╔════╝██╔═══██╗████╗  ██║██║██╔════╝
#    ███╔╝ ███████╗██║   ██║██╔██╗ ██║██║█████╗
#   ███╔╝  ╚════██║██║   ██║██║╚██╗██║██║██╔══╝
#  ███████╗███████║╚██████╔╝██║ ╚████║██║███████╗
#  ╚══════╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝╚══════╝
#
#  RofiLauncher — launch the rofilauncher that search for .desktop
#  Repo: https://github.com/SaruM4N3/42_bspwm_dotfile
# =============================================================

# Main vars
cfgStyle="$HOME/.config/bspwm/config/.launcher"
[ -f "$cfgStyle" ] || echo "1" > "$cfgStyle"
read -r current_style < "$cfgStyle"

# Paths
styleDir="$HOME/.config/bspwm/config/rofi-themes"
rofiAssetDir="$HOME/.config/bspwm/config/assets"

# Function to select the styles
choose_launcher_style() {

    # Find styles
    styles=$(find "$styleDir" -type f -name 'style_*.rasi' | sed 's|.*/style_\([0-9]*\)\.rasi|\1|' | sort -n)

    # Find current style
    selected_index=-1
    index=0
    IFS='
'
    for style in $styles; do
        if [ "$style" = "$current_style" ]; then
            selected_index=$index
            break
        fi
        index=$((index + 1))
    done
    unset IFS

    # Show the rofi selection menu
    selected=$(
    IFS='
'
    for style in $styles; do
        printf "%s\000icon\037%s/style_%s.webp\n" "$style" "$rofiAssetDir" "$style"
    done | rofi -dmenu \
                -theme "$styleDir/StyleSelect.rasi" \
                -selected-row "$selected_index"
    )

    # Write the selection to config file
    [ -n "$selected" ] && echo "${selected}" > "$cfgStyle"

}

launch_launcher () {
    ROFI_THEME="$styleDir/style_$current_style.rasi"

    # -format 'f' outputs the full .desktop file path instead of the app name.
    # Ctrl+Delete = custom-1 (exit 10) → remove/hide the app.
    result=$(rofi -show drun \
        -theme "$ROFI_THEME" \
        -kb-cancel "Escape,F13" \
        -kb-custom-1 "ctrl+x" \
        -format 'f' \
        ${POLY_ROFI_POS:+-theme-str "$POLY_ROFI_POS"})
    rc=$?

    case $rc in
        0)
            # Normal launch
            [ -n "$result" ] && gio launch "$result" 2>/dev/null &
            ;;
        10)
            # Right-click / shift+Delete — remove or hide the app
            [ -z "$result" ] && return
            app_name=$(grep -m1 "^Name=" "$result" 2>/dev/null | cut -d= -f2)
            [ -z "$app_name" ] && app_name=$(basename "$result" .desktop)

            if echo "$result" | grep -q "$HOME"; then
                # User app (~/.local/share/applications) — delete it
                confirm=$(printf "Yes\nNo" | rofi -dmenu \
                    -theme "$ROFI_THEME" \
                    -p "Remove '$app_name' from launcher?")
                if [ "$confirm" = "Yes" ]; then
                    rm "$result"
                    dunstify -u low "Removed" "'$app_name' removed from launcher."
                fi
            else
                # System app — hide with a local override instead of deleting
                confirm=$(printf "Yes\nNo" | rofi -dmenu \
                    -theme "$ROFI_THEME" \
                    -p "Hide '$app_name' from launcher?")
                if [ "$confirm" = "Yes" ]; then
                    mkdir -p "$HOME/.local/share/applications"
                    printf '[Desktop Entry]\nHidden=true\n' \
                        > "$HOME/.local/share/applications/$(basename "$result")"
                    dunstify -u low "Hidden" "'$app_name' hidden from launcher."
                fi
            fi
            ;;
    esac
}

# -- Main executor -- #
case "$1" in
    --choose-style)
        choose_launcher_style ;;
    --launcher | *)
        launch_launcher ;;
esac
