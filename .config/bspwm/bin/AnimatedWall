#!/bin/sh
# =============================================================
#  ███████╗███████╗ ██████╗ ███╗   ██╗██╗███████╗
#  ╚══███╔╝██╔════╝██╔═══██╗████╗  ██║██║██╔════╝
#    ███╔╝ ███████╗██║   ██║██╔██╗ ██║██║█████╗
#   ███╔╝  ╚════██║██║   ██║██║╚██╗██║██║██╔══╝
#  ███████╗███████║╚██████╔╝██║ ╚████║██║███████╗
#  ╚══════╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝╚══════╝
#
#  AnimatedWall - handle animated wall
#  Repo: https://github.com/SaruM4N3/42_bspwm_dotfile
# =============================================================

# mpv decode/output options per machine (DMI vendor). Each 42 machine has a
# different GPU, so each gets its own profile; test a change with
#   AnimatedWall --start <video>  and check mpv CPU in btop.
#   ANIMWALL_PROFILE=mac|dell|lenovo|safe overrides the detection.
machine_profile() {
    [ -n "$ANIMWALL_PROFILE" ] && { echo "$ANIMWALL_PROFILE"; return; }
    case "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)" in
        "Apple Inc."*) echo mac ;;
        "Dell Inc."*)  echo dell ;;
        LENOVO*)       echo lenovo ;;
        *)             echo safe ;;
    esac
}

# Safe fallback: CPU decoding + XV output, works everywhere (no Mesa/DRI needed)
SAFE_OPTS="--hwdec=no -vo xv --vd-lavc-threads=0"

mpv_opts() {
    case "$1" in
        # iMac18,3 (Radeon RX 570/580): VA-API decode + GPU output through the
        # Ubuntu mesa/VA drivers set up in bspwmrc (GL_SHIM, LIBVA_DRIVERS_PATH).
        # 4K H.264 wallpaper: ~6% CPU instead of ~59% with the safe profile.
        mac)    echo "--hwdec=vaapi --vo=gpu" ;;
        # Dell OptiPlex 7400 AIO (Intel UHD 770): VA-API via the host iHD driver.
        # Vulkan init fails in junest, so force OpenGL to skip that probe.
        # 4K H.264 wallpaper: ~9% CPU instead of ~77% with the safe profile.
        dell)   echo "--hwdec=vaapi --vo=gpu --gpu-api=opengl" ;;
        # Lenovo (NVIDIA PRIME): not tested yet — keep the safe profile
        # until tested (e.g. try "--hwdec=nvdec --vo=gpu").
        lenovo) echo "$SAFE_OPTS" ;;
        *)      echo "$SAFE_OPTS" ;;
    esac
}

launch_wall() { # geometry aspect video opts...
    geometry="$1" videoaspect="$2" video="$3"; shift 3
    xwinwrap -g "$geometry" -un -fdt -ni -b -nf \
        -- mpv $* --no-audio --no-border --no-config \
        --no-window-dragging --no-input-default-bindings --no-osd-bar \
        --no-sub --loop -wid WID --cache=yes \
        --video-aspect-override="$videoaspect" \
        "$video" > /dev/null 2>&1 &
    echo $!
}

start() {
    video_path="$1"
    profile=$(machine_profile)
    opts=$(mpv_opts "$profile")

    case "$video_path" in
        *.mp4|*.mkv|*.gif) ;;
        *)
            echo "[-] The file does not have a valid video extension"
            exit 1
        ;;
    esac

    # Get full geometry of each screen (ex: "1920x1080+1366+0")
    SCREENS=$(xrandr | grep -Eo '[0-9]+x[0-9]+\+[0-9]+\+[0-9]+')

    gcd() {
        a="$1" b="$2"
        while [ "$b" -ne 0 ]; do
            temp="$b"
            b=$((a % b))
            a=$temp
        done
        echo "$a"
    }

    for geometry in $SCREENS; do
        # Extract resolution and coordinates
        resolution=$(echo "$geometry" | cut -d'+' -f1)
        width=$(echo "$resolution" | cut -d'x' -f1)
        height=$(echo "$resolution" | cut -d'x' -f2)

        # Calculate aspect ratio
        g=$(gcd "$width" "$height")
        aspect_width=$((width / g))
        aspect_height=$((height / g))

        case "${aspect_width}:${aspect_height}" in
            "8:5") videoaspect="16:10" ;;
            "4:3") videoaspect="4:3" ;;
            "16:9") videoaspect="16:9" ;;
            "21:9") videoaspect="21:9" ;;
            *) videoaspect="${aspect_width}:${aspect_height}" ;;
        esac

        # INFO: for each screen, launch the video with the appropriate aspect ratio
        pid=$(launch_wall "$geometry" "$videoaspect" "$video_path" $opts)
        # If the machine profile's GPU path dies on startup, fall back to the safe one
        if [ "$opts" != "$SAFE_OPTS" ]; then
            sleep 2
            if ! kill -0 "$pid" 2>/dev/null; then
                echo "[!] AnimatedWall: profile '$profile' failed, using safe options" >&2
                launch_wall "$geometry" "$videoaspect" "$video_path" $SAFE_OPTS >/dev/null
            fi
        fi
    done
}

stop() {
    # Kill mpv children of xwinwrap first (GPU teardown is slow on SIGTERM),
    # then kill xwinwrap itself — both with SIGKILL for instant termination
    for pid in $(pgrep xwinwrap 2>/dev/null); do
        kill -9 "$(pgrep -P "$pid" 2>/dev/null)" 2>/dev/null
        kill -9 "$pid" 2>/dev/null
    done
    true
}

print_help() {
    echo "Usage: AnimatedWall [--start] [--stop] video_path"
    echo "    --start   Start playback of video file."
    echo "    --stop    Stop active playback."
}

if [ "$#" -eq 0 ]; then
    print_help
    exit 1
fi

while [ "$#" -gt 0 ]; do
    case $1 in
        --start)
            shift
            start "$1"
            shift
            ;;
        --stop)
            shift
            stop
            ;;
        *)
            echo "Unknown parameter: $1"
            exit 1
            ;;
    esac
done
