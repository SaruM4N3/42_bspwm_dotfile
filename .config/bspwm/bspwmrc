#    ███╔╝ ███████╗██║   ██║██╔██╗ ██║██║█████╗
#   ███╔╝  ╚════██║██║   ██║██║╚██╗██║██║██╔══╝
#  ███████╗███████║╚██████╔╝██║ ╚████║██║███████╗
#  ╚══════╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝╚══════╝
#
#  bspwmrc — window manager startup configuration
#  Repo: https://github.com/SaruM4N3/42_bspwm_dotfile
# =============================================================

# The overlay's ld.so.cache is Arch-only (from ~/.junest/etc/) and doesn't know
# about Ubuntu's /usr/lib/x86_64-linux-gnu. Explicitly set both in LD_LIBRARY_PATH
# so the linker finds them without needing ldconfig:
#   /usr/lib          — Arch's readline 8.3 wins over Ubuntu's 8.1 (missing symbol)
#   /usr/lib/x86_64-linux-gnu — Ubuntu's libLLVM-15 and other multilib deps for GL
export LD_LIBRARY_PATH="/usr/lib:/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Set environment variables
export PATH="$HOME/.config/bspwm/bin:$HOME/.cache/bspwm/gnome-wrappers:$PATH"

export LIBVA_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri

# Use Ubuntu's mesa GL/EGL libraries so all apps get hardware-accelerated OpenGL.
# junest's Arch mesa (even 24.3.4) can't negotiate GLX visuals with Ubuntu's Xorg
# server. Ubuntu's mesa 23.2.1 supports DRM 3.42 (kernel 5.15) natively.
# GL_SHIM contains only GL/EGL symlinks — not libstdc++/glibc — so Arch binaries
# keep their own C++ runtime while getting the compatible GL stack.
export GL_SHIM="$HOME/.config/bspwm/gl-host"
export LD_LIBRARY_PATH="$GL_SHIM${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LIBGL_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri

# NVIDIA PCs: bspwm.sh symlinks the host's NVIDIA libs (must match the kernel module
# exactly) into BSPWM_HOST_NVLIB. Must come before /usr/lib, which holds Arch's
# mismatched libGLX_nvidia → GLX BadValue (kitty/picom die) and Xorg segfault on exit.
[ -n "$BSPWM_HOST_NVLIB" ] && [ -d "$BSPWM_HOST_NVLIB" ] && \
    export LD_LIBRARY_PATH="$BSPWM_HOST_NVLIB:$LD_LIBRARY_PATH"

export XDG_CURRENT_DESKTOP='bspwm'

# Startup timing: ms since bspwmrc started, per step -> ~/.BspwmLogs/startup_times.log
_T0=$(date +%s%N)
_TLOG="$HOME/.BspwmLogs/startup_times.log"
export _T0 _TLOG
mkdir -p "${_TLOG%/*}"; echo "--- $(date '+%F %T.%3N') ---" > "$_TLOG"
_t() { echo "$(( ($(date +%s%N) - _T0) / 1000000 )) ms  $1" >> "$_TLOG"; }
## Fix java applications
export _JAVA_AWT_WM_NONREPARENTING=1

#  ╦ ╦╔═╗╦═╗╦╔═╔═╗╔═╗╔═╗╔═╗╔═╗╔═╗
#  ║║║║ ║╠╦╝╠╩╗╚═╗╠═╝╠═╣║  ║╣ ╚═╗
#  ╚╩╝╚═╝╩╚═╩ ╩╚═╝╩  ╩ ╩╚═╝╚═╝╚═╝

MonitorSetup
_t "MonitorSetup"

#  ╔╗ ╔═╗╔═╗╦ ╦╔╦╗  ╔═╗╔═╗╔╗╔╔═╗╦╔═╗
#  ╠╩╗╚═╗╠═╝║║║║║║  ║  ║ ║║║║╠╣ ║║ ╦
#  ╚═╝╚═╝╩  ╚╩╝╩ ╩  ╚═╝╚═╝╝╚╝╚  ╩╚═╝

bspc config external_rules_command "${HOME}"/.config/bspwm/bin/ExternalRules

bspc config window_gap 3
bspc config split_ratio               0.51
bspc config single_monocle            true

bspc config automatic_scheme          longest_side
bspc config initial_polarity          second_child
bspc config removal_adjustment        true

bspc config focus_follows_pointer     true
bspc config pointer_follows_focus     false
bspc config pointer_follows_monitor   true
bspc config pointer_motion_interval   7
bspc config pointer_modifier          mod4
bspc config pointer_action1           move
bspc config pointer_action2           resize_side
bspc config pointer_action3           resize_corner

#  ╔═╗╦ ╦╔╦╗╔═╗╔═╗╔╦╗╔═╗╦═╗╔╦╗
#  ╠═╣║ ║ ║ ║ ║╚═╗ ║ ╠═╣╠╦╝ ║
#  ╩ ╩╚═╝ ╩ ╚═╝╚═╝ ╩ ╩ ╩╩╚═ ╩

run() {
  if ! pidof -q "$1"; then
    "$@" &
  fi
}

# Wait (max ~3 s) for every process with this exact name to be gone
wait_gone() {
  _n=0
  while pgrep -x "$1" >/dev/null && [ "$_n" -lt 40 ]; do
    sleep 0.05; _n=$((_n + 1))
  done
}

# Set system vars for polybar
"$HOME"/.config/bspwm/bin/SetSysVars
_t "SetSysVars"

# Ubuntu GUI apps typed in a terminal (firefox, nautilus...) run on the host:
# wrappers in ~/.cache/bspwm/gnome-wrappers, see host-wrappers (background, ~0.3 s)
"$HOME"/.config/bspwm/bin/host-wrappers >/dev/null 2>&1 &

# Launch sxhkd daemon
run sxhkd -c "${HOME}"/.config/bspwm/config/sxhkdrc

# Stop any xcape left over from the old Super-tap launcher binding
pkill -x xcape 2>/dev/null

# Restore config files from session save, fallback to original backup
SESSION_DIR="$HOME/.config/bspwm/config/.session"
BACKUP_DIR="$HOME/.local/share/gh0stzk/config/bspwm/config"
CONFIG_DIR="$HOME/.config/bspwm/config"
for f in picom.conf picom-animations.conf xsettingsd jgmenurc; do
    if [ ! -s "$CONFIG_DIR/$f" ]; then
        if [ -s "$SESSION_DIR/$f" ]; then
            cp "$SESSION_DIR/$f" "$CONFIG_DIR/$f"
        elif [ -f "$BACKUP_DIR/$f" ]; then
            cp "$BACKUP_DIR/$f" "$CONFIG_DIR/$f"
        fi
    fi
done

# Restore micro editor settings from session
MICRO_DIR="$HOME/.config/micro"
MICRO_SESSION="$SESSION_DIR/micro"
if [ -d "$MICRO_SESSION" ]; then
    mkdir -p "$MICRO_DIR/colorschemes"
    [ -s "$MICRO_SESSION/settings.json" ] && cp "$MICRO_SESSION/settings.json" "$MICRO_DIR/settings.json"
    [ -s "$MICRO_SESSION/bindings.json" ] && cp "$MICRO_SESSION/bindings.json" "$MICRO_DIR/bindings.json"
    for cs in "$MICRO_SESSION/colorschemes/"*.micro; do
        [ -f "$cs" ] && cp "$cs" "$MICRO_DIR/colorschemes/"
    done
fi
# dunstrc: always restore from backup (module truncates global section each run)
cp "$BACKUP_DIR/dunstrc" "$CONFIG_DIR/dunstrc"
_t "config restore"

# Launch dunst
mkdir -p /run/user/$(id -u)/dunst /run/user/$(id -u)/clipcat /run/user/$(id -u)/ft_lock
pkill -x dunst 2>/dev/null; dunst -config "${HOME}"/.config/bspwm/config/dunstrc &
_t "dunst"

# Generate cheatsheet font scale before eww starts so fresh CSS is baked in
_cs_h=$(xrandr --current | awk '/\*/{match($0,/[0-9]+x([0-9]+)/,a); if(a[2]+0>m) m=a[2]+0} END{print m}')
_cs_h=${_cs_h:-1080}
if   [ "$_cs_h" -ge 2160 ]; then _cs_key="1.5rem"; _cs_alt="1.1rem"; _cs_cat="1rem";   _cs_title="3rem";  _cs_col="450px"
elif [ "$_cs_h" -ge 1440 ]; then _cs_key="1.2rem"; _cs_alt="0.95rem"; _cs_cat="0.9rem"; _cs_title="2.5rem"; _cs_col="380px"
else                              _cs_key="1rem";   _cs_alt="0.8rem"; _cs_cat="0.8rem"; _cs_title="2rem";  _cs_col="300px"
fi
cat > "${HOME}/.config/bspwm/eww/cheatsheet/_cs_scale.scss" << EOF
// Generated by bspwmrc based on screen resolution — do not edit manually
.title { font-size: ${_cs_title}; }
.keys { font-size: ${_cs_key}; }
.keys-alt { font-size: ${_cs_alt}; }
.category-bspwm, .category-system, .category-nodes, .category-move,
.category-apps, .category-workspaces, .category-power,
.category-preselection, .category-others { font-size: ${_cs_cat}; }
.column { min-width: ${_cs_col}; }
EOF
_t "cheatsheet scale (xrandr)"

# Restart eww daemon BEFORE ThemeLaunch so Bar.bash and widgets start with fresh CSS
pkill -x eww 2>/dev/null; wait_gone eww
eww -c "${HOME}"/.config/bspwm/eww daemon &
# Wait until the daemon answers before ThemeLaunch opens widgets. Each failed ping
# already retries for ~1 s on its own, so 5 tries is a ~5 s cap.
_n=0
until eww -c "${HOME}"/.config/bspwm/eww ping >/dev/null 2>&1 || [ "$_n" -ge 5 ]; do
    _n=$((_n + 1))
done
_t "eww daemon"

# Kill picom before ThemeLaunch so 01-picom.sh writes config with no race
pkill -x picom 2>/dev/null; wait_gone picom

# Load current theme (Bar, picom config, wallpaper, bspwm rules, dunst, etc.)
"${HOME}"/.config/bspwm/bin/ThemeLaunch
_t "ThemeLaunch"

# First bspwm session on a new machine: hide the default launcher apps listed in
# config/hidden-apps (bspwm launcher only, GNOME untouched). Runs once, so apps
# shown again from Rice Settings > Apps stay shown.
_HIDDEN_DONE="$HOME/.config/bspwm/.hidden-apps-applied"
if [ ! -e "$_HIDDEN_DONE" ] && [ -f "$HOME/.config/bspwm/config/hidden-apps" ]; then
    (
        grep -v -e '^#' -e '^[[:space:]]*$' "$HOME/.config/bspwm/config/hidden-apps" |
            while read -r _app; do
                "$HOME/.config/bspwm/bin/app-visibility" hide "$_app" >/dev/null 2>&1
            done
        touch "$_HIDDEN_DONE"
    ) &
fi

# Launch mpd
pgrep -x mpd >/dev/null || mpd "${HOME}"/.config/mpd/mpd.conf
_t "mpd"

# Kill gsd-power to prevent auto-brightness via iio-sensor-proxy
pkill -x gsd-power 2>/dev/null

# GLX backend via GL_SHIM (Ubuntu mesa 23.2.1 — set above) so picom's GLSL
# shader renders border color correctly at rounded corners.
pkill -x picom 2>/dev/null
# No compositor in gamer mode (GamerMode starts it again when turned off)
"${HOME}"/.config/bspwm/bin/GamerMode --is-on ||
    picom --config "${HOME}"/.config/bspwm/config/picom.conf &
_t "picom"

# NVIDIA only: picom hangs after DPMS off/on (lock -> black screen), restart it
"${HOME}"/.config/bspwm/bin/DpmsWatch &

# Animated wallpaper is restored by ThemeLaunch → 06-wallpaper.sh (ENGINE=Animated)

# Launch ft_lock daemon
# ft_lock daemon is started outside bwrap by bspwm.sh (overlay prevents exec here)

# Load Xresources (urxvt colors, scrollbar config)
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"
_t "xrdb"

# Launch xsettingsd
run xsettingsd --config="${HOME}"/.config/bspwm/config/xsettingsd >/dev/null 2>&1

# Mouse speed / acceleration (RiceSettings → System, MOUSE_* in theme-config.bash)
"${HOME}"/.config/bspwm/bin/MouseSettings &

# Keyboard layout: restore the last one used (KeyBoardL saves it)
"${HOME}"/.config/bspwm/bin/KeyBoardL --restore &

# Launch clipboard daemon
run clipcatd

# Launch polkit
run lxpolkit
_t "daemons"

# Start one time message
[ ! -f "$HOME/.config/bspwm/config/.first_run_done" ] && alacritty --hold -e sh -c 'cat "$HOME/.config/bspwm/config/FirstMessage.txt"; sleep 0.1' && touch "$HOME/.config/bspwm/config/.first_run_done"

# Start dbus if not running
if ! pgrep -x dbus-daemon >/dev/null; then
    eval "$(dbus-launch --sh-syntax --exit-with-session)"
fi
_t "dbus"

# BT favorite reconnect daemon
pkill -f bt-reconnect 2>/dev/null
"${HOME}"/.config/bspwm/bin/bt-reconnect &

# Apply timezone (junest has no systemd; enforce on every startup)
sudo ln -sf /usr/share/zoneinfo/Europe/Paris /etc/localtime
echo "Europe/Paris" | sudo tee /etc/timezone > /dev/null 2>&1
_t "timezone (sudo) - done"
